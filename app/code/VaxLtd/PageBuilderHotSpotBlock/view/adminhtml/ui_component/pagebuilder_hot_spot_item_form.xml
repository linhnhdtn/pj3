<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">
                pagebuilder_hot_spot_item_form.pagebuilder_hot_spot_item_form_data_source
            </item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
        <item name="label" xsi:type="string" translate="true">Item</item>
    </argument>
    <settings>
        <dataScope>data</dataScope>
        <deps>
            <dep>pagebuilder_hot_spot_item_form.pagebuilder_hot_spot_item_form_data_source</dep>
        </deps>
        <namespace>pagebuilder_hot_spot_item_form</namespace>
        <buttons>
            <button name="save" class="Magento\PageBuilder\Block\Adminhtml\ContentType\Edit\SaveButton"/>
            <button name="cancel" class="VaxLtd\PageBuilderHotSpotBlock\Block\Adminhtml\ModalCancelButton"/>
        </buttons>
        <selectorPrefix>.block-hot-spot-block-item-form</selectorPrefix>
    </settings>
    <dataSource name="pagebuilder_hot_spot_item_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">
                    VaxLtd_PageBuilderCore/js/content-type/form/child-item-provider
                </item>
                <item name="eventPrefix" xsi:type="string">hotSpotBlockItem</item>
            </item>
        </argument>
        <dataProvider name="pagebuilder_hot_spot_item_form_data_source"
                      class="Magento\PageBuilder\Model\ContentType\DataProvider">
            <settings>
                <requestFieldName/>
                <primaryFieldName/>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general" sortOrder="10">
        <settings>
            <label/>
        </settings>
        <field name="image" formElement="imageUploader" sortOrder="11">
            <settings>
                <label translate="true">Image</label>
                <componentType>imageUploader</componentType>
            </settings>
            <formElements>
                <imageUploader>
                    <settings>
                        <isMultipleFiles>false</isMultipleFiles>
                        <allowedExtensions>jpg jpeg gif png</allowedExtensions>
                        <maxFileSize>4194304</maxFileSize>
                        <uploaderConfig>
                            <param xsi:type="string" name="url">pagebuilder/contenttype/image_upload</param>
                        </uploaderConfig>
                        <previewTmpl>Magento_PageBuilder/form/element/uploader/preview</previewTmpl>
                    </settings>
                </imageUploader>
            </formElements>
        </field>
        <field name="x" sortOrder="12" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">X</label>
                <dataScope>x</dataScope>
            </settings>
        </field>
        <field name="y" sortOrder="13" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Y</label>
                <dataScope>y</dataScope>
            </settings>
        </field>
        <field name="description" sortOrder="14" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Description</label>
                <dataScope>description</dataScope>
            </settings>
        </field>
    </fieldset>
</form>
