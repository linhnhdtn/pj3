<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">
                pagebuilder_page_banner_item_form.pagebuilder_page_banner_item_form_data_source
            </item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
        <item name="label" xsi:type="string" translate="true">Item</item>
    </argument>
    <settings>
        <dataScope>data</dataScope>
        <deps>
            <dep>pagebuilder_page_banner_item_form.pagebuilder_page_banner_item_form_data_source</dep>
        </deps>
        <namespace>pagebuilder_page_banner_item_form</namespace>
        <buttons>
            <button name="save" class="Magento\PageBuilder\Block\Adminhtml\ContentType\Edit\SaveButton"/>
            <button name="cancel" class="VaxLtd\PageBuilderPageBanner\Block\Adminhtml\ModalCancelButton"/>
        </buttons>
        <selectorPrefix>.block-page-banner-item-form</selectorPrefix>
    </settings>
    <dataSource name="pagebuilder_page_banner_item_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">
                    VaxLtd_PageBuilderCore/js/content-type/form/child-item-provider
                </item>
                <item name="eventPrefix" xsi:type="string">pageBannerItem</item>
            </item>
        </argument>
        <dataProvider name="pagebuilder_page_banner_item_form_data_source"
                      class="Magento\PageBuilder\Model\ContentType\DataProvider">
            <settings>
                <requestFieldName/>
                <primaryFieldName/>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general" sortOrder="10">
        <settings>
            <label/>
        </settings>
        <field name="title" sortOrder="10" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Title</label>
                <dataScope>title</dataScope>
            </settings>
        </field>
        <field name="desktop_image" formElement="imageUploader" sortOrder="11">
            <settings>
                <label translate="true">Background Desktop</label>
                <componentType>imageUploader</componentType>
            </settings>
            <formElements>
                <imageUploader>
                    <settings>
                        <isMultipleFiles>false</isMultipleFiles>
                        <allowedExtensions>jpg jpeg gif png</allowedExtensions>
                        <maxFileSize>4194304</maxFileSize>
                        <uploaderConfig>
                            <param xsi:type="string" name="url">pagebuilder/contenttype/image_upload</param>
                        </uploaderConfig>
                        <previewTmpl>Magento_PageBuilder/form/element/uploader/preview</previewTmpl>
                    </settings>
                </imageUploader>
            </formElements>
        </field>
        <field name="mobile_image" formElement="imageUploader" sortOrder="12">
            <settings>
                <label translate="true">Background Mobile</label>
                <componentType>imageUploader</componentType>
            </settings>
            <formElements>
                <imageUploader>
                    <settings>
                        <isMultipleFiles>false</isMultipleFiles>
                        <allowedExtensions>jpg jpeg gif png</allowedExtensions>
                        <maxFileSize>2097152</maxFileSize>
                        <uploaderConfig>
                            <param xsi:type="string" name="url">pagebuilder/contenttype/image_upload</param>
                        </uploaderConfig>
                        <previewTmpl>Magento_PageBuilder/form/element/uploader/preview</previewTmpl>
                    </settings>
                </imageUploader>
            </formElements>
        </field>
        <field name="desktop_icon" formElement="imageUploader" sortOrder="13">
            <settings>
                <label translate="true">Icon Desktop</label>
                <componentType>imageUploader</componentType>
            </settings>
            <formElements>
                <imageUploader>
                    <settings>
                        <isMultipleFiles>false</isMultipleFiles>
                        <allowedExtensions>jpg jpeg gif png</allowedExtensions>
                        <maxFileSize>2097152</maxFileSize>
                        <uploaderConfig>
                            <param xsi:type="string" name="url">pagebuilder/contenttype/image_upload</param>
                        </uploaderConfig>
                        <previewTmpl>Magento_PageBuilder/form/element/uploader/preview</previewTmpl>
                    </settings>
                </imageUploader>
            </formElements>
        </field>
        <field name="mobile_icon" formElement="imageUploader" sortOrder="14">
            <settings>
                <label translate="true">Icon Mobile</label>
                <componentType>imageUploader</componentType>
            </settings>
            <formElements>
                <imageUploader>
                    <settings>
                        <isMultipleFiles>false</isMultipleFiles>
                        <allowedExtensions>jpg jpeg gif png</allowedExtensions>
                        <maxFileSize>2097152</maxFileSize>
                        <uploaderConfig>
                            <param xsi:type="string" name="url">pagebuilder/contenttype/image_upload</param>
                        </uploaderConfig>
                        <previewTmpl>Magento_PageBuilder/form/element/uploader/preview</previewTmpl>
                    </settings>
                </imageUploader>
            </formElements>
        </field>
        <field name="video_background" formElement="fileUploader" sortOrder="15"
               template="VaxLtd_PageBuilderCore/form/element/uploader/video">
            <settings>
                <label translate="true">Video Background</label>
            </settings>
            <formElements>
                <fileUploader>
                    <settings>
                        <isMultipleFiles>true</isMultipleFiles>
                        <allowedExtensions>mov mp4</allowedExtensions>
                        <maxFileSize>20971520</maxFileSize>
                        <uploaderConfig>
                            <param xsi:type="string" name="url">vaxltd_pagebuilder/contenttype/video_upload</param>
                        </uploaderConfig>
                        <previewTmpl>VaxLtd_PageBuilderCore/form/element/uploader/video/preview</previewTmpl>
                    </settings>
                </fileUploader>
            </formElements>
        </field>
    </fieldset>
</form>
